# Site block for the host's Caddy (/etc/caddy/Caddyfile). Caddy obtains the
# HTTPS certificate itself; the DNS record must point at the VPS (not proxied).
bal.aansl.com {
	# The default encode matcher skips video/audio/images, so Range responses stay byte-exact.
	encode zstd gzip
	# Two slots for zero-downtime deploys (deploy/deploy.sh): bal-blue on 18090, bal-green on 18091.
	# Normally only one runs; Caddy sends traffic to the first healthy one, and while a deploy
	# swaps them a request that finds a port closed is retried on the other for up to 10 s.
	reverse_proxy 127.0.0.1:18090 127.0.0.1:18091 {
		lb_policy first
		lb_try_duration 10s
		lb_try_interval 250ms
		fail_duration 10s
		health_uri /healthz
		health_interval 2s
		health_timeout 2s
	}
}
