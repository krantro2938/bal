# Copy to /srv/bal/bal.env on the VPS (chmod 600). Never commit the real file.
BAL_PUBLIC_URL=https://bal.aansl.com
# Caddy/nginx in front: take the client IP (for sign-in rate limits) from X-Forwarded-For.
BAL_TRUST_PROXY=1
# Google sign-in (optional; email+password always works).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID → "Web application",
# authorized redirect URI: https://bal.aansl.com/auth/google/callback
BAL_GOOGLE_CLIENT_ID=
BAL_GOOGLE_CLIENT_SECRET=
# Never enable on a public server:
BAL_DEV_LOGIN=0
# Share links that Telegram can preview (served from a server outside Russia).
BAL_SHARE_URL=https://go.bal.aansl.com
# Who can approve, pin and delete comments: emails of verified sign-ins (e.g. Google), comma-separated.
BAL_MODERATORS=
